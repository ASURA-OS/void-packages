# Template file for 'hyprtoolkit'
pkgname=hyprtoolkit
version=0.7.0
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config hyprwayland-scanner wayland-devel"
makedepends="aquamarine hyprgraphics-devel hyprutils hyprlang wayland-devel
 wayland-protocols MesaLib-devel pixman-devel libdrm-devel libgbm-devel
 libxkbcommon-devel pango-devel cairo-devel iniparser-devel abseil-cpp-devel"
short_desc="Modern C++ Wayland-native GUI toolkit for Hyprland apps"
maintainer="mohitjoer <mohitjoe.r@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprtoolkit"
distfiles="https://github.com/hyprwm/hyprtoolkit/archive/refs/tags/v${version}.tar.gz"
checksum=7dc82a531537fd068f51110fa49c4cab01f3419d9e2cb8c2c2f2e8c49e26bcde
nocross="ASURA builds this stack for x86_64 only"

post_install() {
	vlicense LICENSE
}

hyprtoolkit-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} aquamarine hyprgraphics-devel hyprutils hyprlang wayland-devel MesaLib-devel pixman-devel libdrm-devel libgbm-devel libxkbcommon-devel pango-devel cairo-devel iniparser-devel abseil-cpp-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
