# Template file for 'hyprgraphics'
pkgname=hyprgraphics
version=0.6.0
revision=2
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config"
makedepends="hyprutils libdrm-devel pixman-devel cairo-devel pango-devel
 libjpeg-turbo-devel libwebp-devel file-devel libpng-devel librsvg-devel
 libjxl-devel libheif-devel MesaLib-devel"
short_desc="Hyprland graphics and resource utilities library"
maintainer="mohitjoer <mohitjoe.r@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprgraphics"
distfiles="https://github.com/hyprwm/hyprgraphics/archive/refs/tags/v${version}.tar.gz"
checksum=27e9e19ff59ba75a2963d72c3dcb5c0840b266b90d7fca6d5df7cac105419b08

post_install() {
	vlicense LICENSE
}

hyprgraphics-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} hyprutils cairo-devel pango-devel MesaLib-devel libdrm-devel pixman-devel libpng-devel libjpeg-turbo-devel libwebp-devel librsvg-devel file-devel libjxl-devel libheif-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
